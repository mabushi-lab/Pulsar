#pragma once

// WiFi credentials
#define WIFI_SSID       "YourNetworkName"
#define WIFI_PASSWORD   "YourNetworkPassword"

// Password for over-the-air firmware updates. Once this is set, pushing new
// firmware is:
//
//   pio run -t upload --upload-port pulsar.local --upload-flags --auth=...
//
// Leave it out and OTA still works, but with no authentication: anyone on the
// same network could replace the firmware on the device. The device's web page
// warns you when this is the case.
#define OTA_PASSWORD    "ChooseSomethingLong"

// Optional: protect the device's web app with a password. Leave this out and
// the dashboard is open to anyone on your network, which is usually what you
// want for a device on your own desk. Set it and the whole web app asks for
// credentials (username "pulsar" unless you also define WEB_USER).
//
// This is plain HTTP, so credentials cross the network base64-encoded rather
// than encrypted. It guards against a housemate and a mis-click, not against
// someone already reading your traffic.
// #define WEB_PASSWORD    "ChooseSomething"
// #define WEB_USER        "pulsar"

// Note: there is no UTC offset here any more. The clock uses a POSIX timezone
// rule (TZ_INFO in src/config.h), so CET/CEST switches automatically. An old
// UTC_OFFSET_SEC line left in your secrets.h is simply ignored.
